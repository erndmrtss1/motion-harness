    "paperTone": "#CFCEC9",
    "ink": "#151C2E",
    "inkTech": "#1F3B70",
    "inkLine": "#2B4C86",
    "inkWash": "#7F95BE",
    "inkText": "#16294F",
    "graphite2B": "#2A2C31",
    "graphiteHB": "#4F535A",
    "graphite2H": "#9A9EA6",
    "graphiteText": "#202226",
    "shadow": "#141C2C",
    "steel": "#A9AFB7",
    "steelDark": "#5E646C",
    "steelLight": "#DDE1E6",
